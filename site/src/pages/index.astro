---
import Layout from "../layouts/Layout.astro";
import SceneGeneratorHero from "../islands/SceneGeneratorHero";

const projects = [
  {
    href: "/projects/synthwave-scene-generator",
    name: "Synthwave Scene Generator",
    summary: "A procedural canvas engine that draws this exact scene — never the same twice.",
    tags: ["TypeScript", "Canvas 2D", "Vite"],
  },
  {
    href: "/projects/shift-swap",
    name: "Shift Swap",
    summary: "A real shift-swap workflow for hourly teams, built from my own experience as a shift lead.",
    tags: ["FastAPI", "SQLModel", "React"],
  },
];
---

<Layout
  title="Home"
  description="Austin Wakefield — early-career web developer directing AI tools with judgment, not just prompts."
>
  <section class="relative h-[70vh] min-h-[420px] w-full overflow-hidden">
    <div class="absolute inset-0">
      <SceneGeneratorHero client:load />
    </div>
    <div
      class="absolute inset-0 flex flex-col items-start justify-center bg-gradient-to-r from-black/85 via-black/40 to-transparent px-6"
    >
      <div class="mx-auto w-full max-w-5xl">
        <h1 class="max-w-xl text-4xl font-semibold text-white drop-shadow-lg sm:text-5xl">
          I direct the tools. The judgment is still mine.
        </h1>
        <p class="mt-4 max-w-lg text-lg text-white/90 drop-shadow">
          Early-career web developer with a Python foundation, building real projects by orchestrating AI instead of
          leaning on it — and documenting every decision along the way.
        </p>
        <div class="mt-6 flex gap-3">
          <a
            href="/projects"
            class="rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white no-underline transition-all hover:opacity-90 hover:shadow-[0_0_24px_-2px_rgba(255,46,136,0.7)]"
          >
            See the projects
          </a>
          <a
            href="/ai-workflow"
            class="rounded-md border border-white/40 px-4 py-2 text-sm font-medium text-white no-underline transition-all hover:border-[var(--accent-2)] hover:shadow-[0_0_20px_-4px_rgba(0,229,255,0.6)]"
          >
            How I actually use AI
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="relative mx-auto max-w-5xl px-6 py-16">
    <h2 class="reveal gradient-text mb-8 text-2xl font-semibold">Recent work</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((project, i) => (
        <a
          href={project.href}
          class="glow-card reveal block rounded-lg border border-white/10 bg-white/5 p-6 no-underline"
          style={`transition-delay: ${i * 100}ms`}
        >
          <h3 class="text-lg font-semibold text-white">{project.name}</h3>
          <p class="mt-2 text-sm text-[var(--text-dim)]">{project.summary}</p>
          <div class="mt-4 flex gap-2">
            {project.tags.map((tag) => (
              <span class="mono rounded border border-white/10 px-2 py-0.5 text-xs text-[var(--accent-2)]">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
