---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" description="Get in touch with Austin Wakefield.">
  <section class="prose mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-semibold text-white">Contact</h1>
    <p class="mt-3 text-[var(--text-dim)]">The best ways to reach me:</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href="mailto:wakefieldaustin1206@gmail.com"
        class="inline-block rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white no-underline"
      >
        Email me
      </a>
      <a
        href="https://www.linkedin.com/in/austin-wakefield-a36522340"
        target="_blank"
        rel="noreferrer"
        class="inline-block rounded-md border border-white/40 px-4 py-2 text-sm font-medium text-white no-underline"
      >
        Message me on LinkedIn
      </a>
    </div>
  </section>
</Layout>
