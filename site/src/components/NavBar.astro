---
const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/ai-workflow", label: "AI Workflow" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header
  class="sticky top-0 z-20 border-b border-white/10 bg-[var(--bg)]/70 backdrop-blur-md"
  style="box-shadow: 0 1px 0 0 rgba(255,46,136,0.15), 0 1px 24px -8px rgba(0,229,255,0.15);"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="gradient-text font-heading text-lg font-semibold no-underline">
      Austin Wakefield
    </a>
    <ul class="flex gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "rounded-md px-3 py-1.5 text-sm no-underline transition-colors",
              isActive(link.href)
                ? "text-[var(--accent-2)]"
                : "text-[var(--text-dim)] hover:text-[var(--text)]",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
