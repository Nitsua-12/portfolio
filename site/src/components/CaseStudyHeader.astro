---
interface Props {
  title: string;
  summary: string;
  tags: string[];
}

const { title, summary, tags } = Astro.props;
---

<header class="mx-auto max-w-3xl px-6 pt-16">
  <a href="/projects" class="mono text-xs text-[var(--accent-2)] no-underline">&larr; All projects</a>
  <h1 class="mt-4 text-3xl font-semibold text-white">{title}</h1>
  <p class="prose mt-3 text-[var(--text-dim)]">{summary}</p>
  <div class="mt-4 flex gap-2">
    {tags.map((tag) => (
      <span class="mono rounded border border-white/10 px-2 py-0.5 text-xs text-[var(--accent-2)]">{tag}</span>
    ))}
  </div>
</header>
